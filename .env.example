# ---------- Punch Prime configuration ----------
# LOCAL USE: you do not need to change anything. Leave this file as is (or do not create .env at all).
# The app stores data in the ./.data folder automatically.

# PRODUCTION (Vercel): paste your Postgres connection string here (Neon / Vercel Postgres / Supabase).
DATABASE_URL=

# PRODUCTION (Vercel): any long random text (32+ characters). Used to sign login sessions.
AUTH_SECRET=

# OPTIONAL: enables real AI bill reading (AI Punch). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
